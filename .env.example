# Copy to .env.local and fill in. Never commit real values.
# Everything prefixed with VITE_ is bundled into the browser app and is PUBLIC.
# Only put publishable values here: never a Supabase secret/service_role key,
# database password, Gemini key, or any account login.

# Backend API base URL (laag-ta-bai-api). Local default shown.
VITE_API_URL=http://localhost:3000

# Supabase project used for sign-in (Supabase Auth).
# Leave both empty to run without Supabase: the app then offers a local
# "dev traveler" sign-in that only works with the API in memory mode.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Google Maps JavaScript API key for the interactive map (not wired up yet).
# Restrict it by HTTP referrer in Google Cloud Console.
VITE_GOOGLE_MAPS_API_KEY=
